<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- GAZEBO SIM PLUGINS -->

  <!-- Differential Drive Controller -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <!-- Geometry and limits mirror base_controllers.yaml -->
      <wheel_separation>0.255</wheel_separation>
      <wheel_radius>0.03</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_linear_acceleration>-0.8</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
      <max_linear_velocity>0.35</max_linear_velocity>
      <min_linear_velocity>-0.35</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_tf>true</odom_publisher_tf>
    </plugin>
  </gazebo>

  <!-- LIDAR Sensor Plugin -->
  <gazebo reference="lidar_link">
    <!-- LD06 -->
    <sensor name="lidar_sensor" type="gpu_lidar">
        <pose relative_to='lidar_link'>0 0 0 0 0 0</pose>
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <ray>
            <scan>
                <horizontal>
                    <samples>455</samples>
                    <resolution>1</resolution>
                    <min_angle>0.0</min_angle>
                    <max_angle>6.283185</max_angle>
                </horizontal>
                <vertical>
                    <samples>1</samples>
                    <resolution>0.01</resolution>
                    <min_angle>0</min_angle>
                    <max_angle>0</max_angle>
                </vertical>
            </scan>
            <range>
                <min>0.02</min>
                <max>12.0</max>
                <resolution>0.01</resolution>
            </range>
        </ray>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <!-- <frame_id>lidar_link</frame_id> -->
      <gz_frame_id>lidar_link</gz_frame_id>
      <!-- <ignition_frame_id>lidar_link</ignition_frame_id> -->
    </sensor>
  </gazebo>

  <!-- BNO055 IMU (needs the world's gz-sim-imu-system) -->
  <gazebo reference="imu_link">
    <sensor name="bno055_imu" type="imu">
      <pose relative_to="imu_link">0 0 0 0 0 0</pose>
      <topic>imu/data</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- Joint State Publisher Plugin -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <topic>joint_states</topic>
      <update_rate>30</update_rate>
    </plugin>
  </gazebo>

  <!-- Pose Publisher Plugin -->
  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
    </plugin>
  </gazebo>

  <!-- Wheel Friction Properties -->
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.0001</minDepth>
    <maxVel>1.0</maxVel>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.0001</minDepth>
    <maxVel>1.0</maxVel>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- Caster 1 Gazebo Properties -->
  <gazebo reference="caster_frontal_wheel">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="caster_frontal_wheel">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- Caster 2 Gazebo Properties -->
  <gazebo reference="caster_rear_wheel">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="caster_rear_wheel">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
</robot>
